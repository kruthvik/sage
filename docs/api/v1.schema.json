    "session.create": {
      "params": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "object",
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 3,
                "maxLength": 2000
              },
              "mode": {
                "enum": [
                  "cram",
                  "learn",
                  "drill",
                  "accelerate"
                ]
              },
              "pace": {
                "enum": [
                  "normal",
                  "speed_up"
                ]
              },
              "timeBudgetMin": {
                "type": "number",
                "minimum": 5,
                "maximum": 1440
              },
              "horizonDays": {
                "type": "number"
              },
              "allowedAids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "accommodations": {
                "type": "string"
              },
              "learnerParams": {
                "type": "string",
                "maxLength": 2000
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exam": {
                "type": "object"
              },
              "preview": {
                "type": "object"
              }
            },
            "required": [
              "objective"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      },
      "learner": true,
      "implemented": true
    },
