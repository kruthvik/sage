{
  "name": "sage",
  "version": "0.0.0",
  "type": "module",
  "description": "A local-first, evidence-grounded personal tutor powered by Pi",
  "license": "MIT",
  "bin": {
    "sage": "apps/cli/src/index.ts"
  },
  "files": ["apps/", "packages/", "resources/", "docs/", "scripts/", "README.md", "brain.md", "LICENSE"],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun apps/cli/src/index.ts",
    "smoke": "bun apps/cli/src/index.ts --smoke",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:publication": "bun scripts/check-publication.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@a2ui/lit": "0.12.0",
    "@a2ui/web_core": "0.12.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "marked": "18.0.11",
    "pdf-lib": "1.17.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
